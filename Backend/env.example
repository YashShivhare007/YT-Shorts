# Environment Variables for Production Deployment
# Copy this file to .env and fill in your actual values

# AssemblyAI API Key for transcription (Hindi optimized)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Flask Configuration
FLASK_ENV=production
FLASK_APP=backed_api.py

# Google Drive API Configuration - SERVICE ACCOUNT JSON
# For production, use Service Account (not OAuth credentials.json)
# Get this from Google Cloud Console > IAM & Admin > Service Accounts
# Create service account > Generate JSON key > Copy entire JSON content
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Optional: Custom port (Render sets this automatically)
# PORT=5000 